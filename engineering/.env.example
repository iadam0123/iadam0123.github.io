# Public example only; never commit live credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./engineering.db
RUN_SCHEMA_CREATE=true
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_API_AUDIENCE=api://<application-client-id>
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=enterprise-knowledge
AZURE_EMBEDDING_DIMENSIONS=1536
ENABLE_METRICS_ENDPOINT=false
